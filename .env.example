# Скопируйте в .env и правьте под себя. Все значения необязательны.

# Адрес self-hosted transfermarkt-api
TRANSFERMARKT_API_URL=http://localhost:8000

# Где слушает дашборд
PORT=5173
HOST=127.0.0.1

# Отслеживаемые лиги (ID Transfermarkt).
# GB1 Премьер-лига · ES1 Ла Лига · IT1 Серия А · L1 Бундеслига · FR1 Лига 1
# RU1 РПЛ · NL1 Эредивизи · PO1 Примейра · TR1 Суперлига · BE1 Про-лига
COMPETITIONS=GB1,ES1,IT1,L1,FR1,RU1

# Сколько клубов брать из каждой лиги (20 = вся лига).
# Меньше клубов → быстрее сборка и меньше нагрузки на источник.
CLUBS_PER_COMPETITION=20

# По скольким самым дорогим игрокам собирать ленту трансферов
TRANSFER_PLAYERS=60

# Как часто пересобирать датасет, минут
REFRESH_MINUTES=60

# Сколько живёт кэш ответов апстрима, часов
CACHE_TTL_HOURS=6

# Параллельных запросов к API (не поднимайте выше 3 — источник начнёт отдавать 429)
CONCURRENCY=3

# false — не собирать данные автоматически при старте (только по кнопке «Обновить»)
AUTO_REFRESH=true
